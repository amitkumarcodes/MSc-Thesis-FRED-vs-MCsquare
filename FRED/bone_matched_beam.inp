    ID = 1
    fieldID = 1
    particle = proton
    Emean = 150
    EFWHM = 0.01
    Xsec = emittance

    emittanceX = 0.00138423
    twissAlphaX = -0.546506
    twissBetaX = 88.6942

    emittanceY = 0.00170177
    twissAlphaY = -0.208773
    twissBetaY = 85.1466

    emittanceRefPlaneDistance = 40
pb>

nprim = 1e7