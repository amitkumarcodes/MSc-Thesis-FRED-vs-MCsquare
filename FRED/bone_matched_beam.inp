# Phantom

region<
    ID = Phantom
    CTscan = CT_HU_200mm_bone.mha
    pivot = [0.5, 0.5, 0]
    O = [0, 0, 0]
    score = [dose-to-water]
region>

lUseInternalHU2Mat = f
include: material.inp


### Beam ###
